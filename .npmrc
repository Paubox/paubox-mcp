# minimum-release-age=0 disables pnpm 10's supply-chain publication-age check.
# Safe here because --frozen-lockfile in CI prevents any package from being
# upgraded beyond what is pinned in pnpm-lock.yaml.
minimum-release-age=0

# pnpm only warns on an engines mismatch by default. The jest suite crashes with
# a stack overflow on Node 20, so make the mismatch a hard stop at install time
# rather than a confusing failure later. See .nvmrc / engines in package.json.
engine-strict=true
