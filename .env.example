# JWT secret for signing OAuth tokens (minimum 32 characters)
# Generate one with: openssl rand -base64 32
JWT_SECRET=your-random-secret-here-min-32-chars

# Paubox API credentials (optional — local-dev fallback only).
# Honored when NODE_ENV !== 'production' AND no OAuth Bearer token /
# x-paubox-* headers / tool parameters were supplied. Production is
# multi-tenant; these variables are deliberately ignored when
# NODE_ENV === 'production' to prevent cross-user credential bleed.
# PAUBOX_API_KEY=your-api-key
# PAUBOX_API_USER=your-api-user@example.com
